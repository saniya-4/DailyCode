class Solution {
    public boolean canPartitionGrid(int[][] grid) {
        long sum=0;
        int n=grid.length;
        int m=grid[0].length;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                sum+=grid[i][j];
            }
        }
        long sum2=0;
        for(int i=0;i<n-1;i++)
        {
           
            for(int j=0;j<m;j++)
            {
                sum2+=grid[i][j];
            }
            if(sum2==(sum-sum2))
            {
                return true;
            }
        }
        sum2=0;
        for(int j=0;j<m-1;j++)
        {
            
            for(int i=0;i<n;i++){
                sum2+=grid[i][j];
            }
            if(sum2==sum-sum2)
            {
                return true;
            }
        }
        return false;
    }
}
