class Solution {
    public String mapWordWeights(String[] words, int[] weights) {
        Map<Integer,Integer>mpp=new HashMap<>();
        for(int i=0;i<26;i++)
        {
            mpp.put(i,weights[i]);
        }
        StringBuilder res=new StringBuilder();
        for(String w:words)
        {
            int sum=0;
            for(char c:w.toCharArray())
            {
                int val=c-'a';
                sum+=mpp.get(val);
            }
            sum=sum%26;
           
           
            char ch=(char)('z'-sum);
            res.append(ch);
        }
        return res.toString();
    }
}
