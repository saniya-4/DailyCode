class Solution {
    public int prefixConnected(String[] words, int k) {
        Map<String,Integer>mpp=new HashMap<>();
        int cnt=0;
        for(String word:words)
        {
            if(word.length()<k)
            {
                continue;
            }
            String prefix=word.substring(0,k);
            mpp.put(prefix,mpp.getOrDefault(prefix,0)+1);

        }
        for(int val:mpp.values())
        {
            if(val>=2)
            {
                cnt+=1;
            }
        }
        return cnt;
    }
}
